<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         WINDOW ACTIONS
         No view bindings: these open Odoo's standard product views, which
         this module extends with the coin fields (coin_product_views.xml).
         ================================================================ -->
    <record id="action_coin_products" model="ir.actions.act_window">
        <field name="name">Coins &amp; Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="domain">[('is_coin_product', '=', True)]</field>
        <field name="context">{'default_is_coin_product': True, 'default_is_storable': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first coin or medal
            </p>
        </field>
    </record>

    <record id="action_coin_eigenprodukte" model="ir.actions.act_window">
        <field name="name">In-House Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="domain">[('is_coin_product', '=', True), ('categ_id.name', 'ilike', '002 Münzen Eigenprodukte')]</field>
        <field name="context">{'default_is_coin_product': True, 'default_is_storable': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first in-house coin
            </p>
        </field>
    </record>

    <record id="action_coin_kundenprodukte" model="ir.actions.act_window">
        <field name="name">Client Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="domain">[('is_coin_product', '=', True), ('categ_id.name', 'ilike', '003 Münzen Kundenprodukte')]</field>
        <field name="context">{'default_is_coin_product': True, 'default_is_storable': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first client coin
            </p>
        </field>
    </record>

    <record id="action_coin_medaillen" model="ir.actions.act_window">
        <field name="name">Medals</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="domain">[('is_coin_product', '=', True), ('categ_id.name', 'ilike', '004 Medaillen')]</field>
        <field name="context">{'default_is_coin_product': True, 'default_is_storable': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first medal
            </p>
        </field>
    </record>

    <!-- ================================================================
         MENUS - root menu is the home-screen app shortcut
         ================================================================ -->
    <menuitem id="menu_coin_root"
              name="Coins"
              web_icon="coin_product_management,static/description/icon.png"
              sequence="60"/>

    <menuitem id="menu_coin_products"
              name="Coins &amp; Products"
              parent="menu_coin_root"
              action="action_coin_products"
              sequence="10"/>

    <menuitem id="menu_coin_eigenprodukte"
              name="In-House Products"
              parent="menu_coin_root"
              action="action_coin_eigenprodukte"
              sequence="20"/>

    <menuitem id="menu_coin_kundenprodukte"
              name="Client Products"
              parent="menu_coin_root"
              action="action_coin_kundenprodukte"
              sequence="30"/>

    <menuitem id="menu_coin_medaillen"
              name="Medals"
              parent="menu_coin_root"
              action="action_coin_medaillen"
              sequence="40"/>

    <menuitem id="menu_coin_configuration"
              name="Configuration"
              parent="menu_coin_root"
              sequence="100"
              groups="base.group_system"/>

    <menuitem id="menu_coin_settings"
              name="Settings"
              parent="menu_coin_configuration"
              action="action_coin_product_config_settings"
              sequence="10"
              groups="base.group_system"/>

    <menuitem id="menu_coin_categories"
              name="Categories"
              parent="menu_coin_configuration"
              action="product.product_category_action_form"
              sequence="20"
              groups="base.group_system"/>

</odoo>
