<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_coin" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.coin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='stock']" position="inside">
                <h2>Numismatic Coin Management</h2>
                <div class="row mt16 o_settings_container" name="coin_management_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="coin_default_currency_id" string="Default Coin Currency"/>
                            <div class="text-muted">
                                Default currency used for numismatic coin pricing display
                            </div>
                            <div class="content-group">
                                <field name="coin_default_currency_id" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <field name="coin_enable_dual_image_kanban"/>
                            <label for="coin_enable_dual_image_kanban" string="Show Obverse &amp; Reverse in Kanban"/>
                            <div class="text-muted">
                                Display both coin faces on Kanban cards instead of a single product image
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="coin_low_mintage_threshold" string="Low Mintage Alert Limit"/>
                            <div class="text-muted">
                                Mintage at or below this value triggers a low mintage warning
                            </div>
                            <div class="content-group">
                                <field name="coin_low_mintage_threshold" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_coin_product_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'coin_product_management'}</field>
    </record>

</odoo>
