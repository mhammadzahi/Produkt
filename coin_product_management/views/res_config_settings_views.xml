<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_coin" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.coin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Numismatic Coin Management" name="coin_management_settings">
                    <setting title="Default Coin Currency"
                             help="Default currency used for numismatic coin pricing display">
                        <field name="coin_default_currency_id"/>
                    </setting>
                    <setting title="Show Obverse &amp; Reverse in Kanban"
                             help="Display both coin faces on Kanban cards instead of a single product image">
                        <field name="coin_enable_dual_image_kanban"/>
                    </setting>
                    <setting title="Low Mintage Alert Limit"
                             help="Mintage at or below this value triggers a low mintage warning">
                        <field name="coin_low_mintage_threshold"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="action_coin_product_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'coin_product_management'}</field>
    </record>

</odoo>
