<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Coin data is merged into Odoo's STANDARD product views (Sales,
         Inventory, Purchase ... all share them). XPath targets below were
         checked against the Odoo 19.0 source of product/ and stock/. -->

    <!-- ================================================================
         LIST VIEW (extends stock's extension of the standard product list,
         so the qty_available column already exists)
         ================================================================ -->
    <record id="view_product_template_list_coin" model="ir.ui.view">
        <field name="name">product.template.list.coin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_stock_product_template_tree"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="string">SKU / Ref</attribute>
            </field>
            <field name="default_code" position="after">
                <field name="coin_metal" widget="badge" optional="show"/>
                <field name="coin_finish" optional="show"/>
                <field name="coin_cover_values" optional="show"/>
                <field name="customer_id" optional="hide"/>
                <field name="customer_phone" optional="hide"/>
                <field name="customer_email" optional="hide"/>
                <field name="coin_mintage" optional="hide"/>
                <field name="coin_weight" optional="hide"/>
                <field name="coin_diameter" optional="hide"/>
                <field name="year_of_issue" optional="hide"/>
                <field name="issuing_country_id" optional="hide"/>
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="qty_available" position="attributes">
                <attribute name="string">Coins Left</attribute>
                <attribute name="decoration-danger">qty_available &lt;= 0</attribute>
            </field>
        </field>
    </record>

    <!-- ================================================================
         KANBAN VIEW (extends stock's extension of the standard kanban)
         ================================================================ -->
    <record id="view_product_template_kanban_coin" model="ir.ui.view">
        <field name="name">product.template.kanban.coin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_kanban_stock_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="qty_available"/>
                <field name="coin_metal"/>
                <field name="coin_finish"/>
                <field name="coin_cover_values"/>
                <field name="customer_id"/>
                <field name="customer_phone"/>
                <field name="customer_email"/>
                <field name="kanban_dual_image_enabled"/>
            </xpath>

            <!-- stock's "On hand: N Units" line becomes "N coins left", red at 0 -->
            <xpath expr="//div[@t-if='record.show_on_hand_qty_status_button.raw_value']" position="replace">
                <div groups="stock.group_stock_user" t-if="record.show_on_hand_qty_status_button.raw_value"
                     t-attf-class="small {{ record.qty_available.raw_value &lt;= 0 ? 'o_coin_stock_out' : 'text-muted' }}">
                    <field name="qty_available"/> coins left
                </div>
            </xpath>

            <xpath expr="//span[@t-if='record.default_code.value']" position="after">
                <div t-if="record.categ_id.raw_value" class="text-muted small">
                    <i class="fa fa-folder-o me-1"/><field name="categ_id"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='product_properties']" position="before">
                <div class="mt-1">
                    <span t-if="record.coin_metal.raw_value" class="badge rounded-pill text-bg-warning me-1">
                        <field name="coin_metal"/>
                    </span>
                    <span t-if="record.coin_finish.raw_value" class="badge rounded-pill text-bg-info me-1">
                        <field name="coin_finish"/>
                    </span>
                    <span t-if="record.coin_cover_values.raw_value" class="badge rounded-pill text-bg-secondary">
                        <field name="coin_cover_values"/>
                    </span>
                </div>
                <div t-if="record.customer_id.raw_value" class="mt-1 text-muted small">
                    <i class="fa fa-user me-1"/><field name="customer_id"/>
                    <span t-if="record.customer_phone.raw_value"> · <field name="customer_phone"/></span>
                    <span t-if="record.customer_email.raw_value"> · <field name="customer_email"/></span>
                </div>
            </xpath>

            <!-- Obverse/reverse instead of the single product image, when enabled in Settings -->
            <field name="image_128" position="attributes">
                <attribute name="invisible">not image_128 or kanban_dual_image_enabled</attribute>
            </field>
            <xpath expr="//aside" position="inside">
                <field name="obverse_image" widget="image" alt="Obverse"
                       options="{'img_class': 'w-100 object-fit-contain'}"
                       invisible="not kanban_dual_image_enabled or not obverse_image"/>
                <field name="reverse_image" widget="image" alt="Reverse"
                       options="{'img_class': 'w-100 object-fit-contain'}"
                       invisible="not kanban_dual_image_enabled or not reverse_image"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         SEARCH VIEW (base standard search; stock's primary Inventory
         search view inherits it, so these filters show there too)
         ================================================================ -->
    <record id="view_product_template_search_coin" model="ir.ui.view">
        <field name="name">product.template.search.coin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="issuing_country_id" string="Issuing Authority"/>
                <field name="customer_id"/>
            </field>
            <filter name="favorites" position="after">
                <separator/>
                <filter string="In-House Products" name="filter_eigenprodukte"
                        domain="[('categ_id.name', 'ilike', '002 Münzen Eigenprodukte')]"/>
                <filter string="Client Products" name="filter_kundenprodukte"
                        domain="[('categ_id.name', 'ilike', '003 Münzen Kundenprodukte')]"/>
                <filter string="Medals" name="filter_medaillen"
                        domain="[('categ_id.name', 'ilike', '004 Medaillen')]"/>
                <separator/>
                <filter string="Gold Coins" name="filter_gold" domain="[('coin_metal', '=', 'gold')]"/>
                <filter string="Silver Coins" name="filter_silver" domain="[('coin_metal', '=', 'silver')]"/>
                <separator/>
                <filter string="In Stock" name="filter_in_stock" domain="[('qty_available', '&gt;', 0)]"/>
                <filter string="Out of Stock" name="filter_out_of_stock" domain="[('qty_available', '&lt;=', 0)]"/>
            </filter>
            <filter name="group_by_categ_id" position="after">
                <filter string="Precious Metal" name="groupby_metal" context="{'group_by': 'coin_metal'}"/>
                <filter string="Finish" name="groupby_finish" context="{'group_by': 'coin_finish'}"/>
                <filter string="Year of Issue" name="groupby_year" context="{'group_by': 'year_of_issue'}"/>
                <filter string="Issuing Authority" name="groupby_country" context="{'group_by': 'issuing_country_id'}"/>
                <filter string="Customer" name="groupby_customer" context="{'group_by': 'customer_id'}"/>
            </filter>
        </field>
    </record>

    <!-- ================================================================
         FORM VIEW EXTENSION
         ================================================================ -->
    <record id="view_coin_product_template_form_inherit" model="ir.ui.view">
        <field name="name">coin.product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_button_box')]" position="after">
                <div class="oe_avatar d-flex" invisible="not is_coin_product">
                    <field name="obverse_image" widget="image" class="oe_avatar"
                           options="{'size': [90, 90]}" alt="Obverse"/>
                    <field name="reverse_image" widget="image" class="oe_avatar"
                           options="{'size': [90, 90]}" alt="Reverse"/>
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Numismatics / Coin Details" name="page_coin_details">
                    <field name="is_coin_product"/>
                    <group>
                        <group string="Technical Specifications">
                            <field name="coin_metal"/>
                            <field name="coin_finish"/>
                            <field name="coin_weight"/>
                            <field name="coin_diameter"/>
                            <field name="coin_mintage"/>
                            <field name="year_of_issue"/>
                            <field name="issuing_country_id"/>
                        </group>
                        <group string="Obverse &amp; Reverse">
                            <field name="obverse_image" widget="image" nolabel="1"/>
                            <field name="reverse_image" widget="image" nolabel="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Customer (Client Products)">
                            <field name="customer_id"/>
                            <field name="customer_phone" widget="phone"/>
                            <field name="customer_email" widget="email"/>
                        </group>
                        <group string="Webshop / WordPress Integration">
                            <field name="wp_pic_obverse_small"/>
                            <field name="wp_pic_reverse_small"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
