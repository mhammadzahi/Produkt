<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         LIST VIEW
         ================================================================ -->
    <record id="view_coin_product_template_list" model="ir.ui.view">
        <field name="name">coin.product.template.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Coins &amp; Medals" sample="1" class="o_coin_list" decoration-danger="qty_available == 0">
                <field name="is_favorite" widget="boolean_favorite" optional="show"/>
                <field name="default_code" string="SKU / Ref" optional="show"/>
                <field name="name" string="Coin Name"/>
                <field name="categ_id" optional="show"/>
                <field name="coin_metal" widget="badge" optional="show"/>
                <field name="coin_finish" optional="show"/>
                <field name="coin_cover_values" string="Coin Cover" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="list_price" string="Sales Price" widget="monetary" optional="show"/>
                <field name="qty_available" string="Coins Left" optional="show"/>
                <field name="uom_id" string="Unit" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="customer_id" string="Customer" optional="hide"/>
                <field name="customer_phone" string="Customer Phone" optional="hide"/>
                <field name="customer_email" string="Customer Email" optional="hide"/>
                <field name="coin_mintage" optional="hide"/>
                <field name="coin_weight" optional="hide"/>
                <field name="coin_diameter" optional="hide"/>
                <field name="year_of_issue" optional="hide"/>
                <field name="issuing_country_id" optional="hide"/>
                <field name="write_date" string="Last Updated" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         KANBAN VIEW
         ================================================================ -->
    <record id="view_coin_product_template_kanban" model="ir.ui.view">
        <field name="name">coin.product.template.kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban string="Coins &amp; Medals" sample="1" class="o_coin_kanban">
                <field name="id"/>
                <field name="write_date"/>
                <field name="is_favorite"/>
                <field name="default_code"/>
                <field name="name"/>
                <field name="categ_id"/>
                <field name="currency_id"/>
                <field name="list_price"/>
                <field name="qty_available"/>
                <field name="coin_metal"/>
                <field name="coin_finish"/>
                <field name="coin_cover_values"/>
                <field name="customer_id"/>
                <field name="customer_phone"/>
                <field name="customer_email"/>
                <field name="image_128"/>
                <field name="obverse_image"/>
                <field name="reverse_image"/>
                <field name="kanban_dual_image_enabled"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start">
                            <t t-if="record.kanban_dual_image_enabled.raw_value">
                                <img t-att-src="'/web/image/product.template/' + record.id.raw_value + '/obverse_image?unique=' + record.write_date.value"
                                     class="o_kanban_image rounded me-1"
                                     alt="Obverse"
                                     style="width:48px;height:48px;object-fit:cover;"/>
                                <img t-att-src="'/web/image/product.template/' + record.id.raw_value + '/reverse_image?unique=' + record.write_date.value"
                                     class="o_kanban_image rounded me-2"
                                     alt="Reverse"
                                     style="width:48px;height:48px;object-fit:cover;"/>
                            </t>
                            <t t-else="">
                                <img t-att-src="'/web/image/product.template/' + record.id.raw_value + '/image_128?unique=' + record.write_date.value"
                                     class="o_kanban_image rounded me-2"
                                     alt="Product"
                                     style="width:56px;height:56px;object-fit:cover;"/>
                            </t>
                            <div class="flex-grow-1 o_kanban_record_body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <field name="is_favorite" widget="boolean_favorite"/>
                                </div>
                                <div class="text-muted small">
                                    <field name="default_code"/>
                                    <span t-if="record.categ_id.raw_value"> · <field name="categ_id"/></span>
                                </div>
                                <div class="mt-1 d-flex align-items-center">
                                    <field name="list_price" widget="monetary"/>
                                    <span t-attf-class="small ms-2 {{ record.qty_available.raw_value == 0 ? 'o_coin_stock_out' : 'o_coin_stock_ok' }}">
                                        <t t-esc="Math.round(record.qty_available.raw_value)"/> coins left
                                    </span>
                                </div>
                                <div class="mt-1">
                                    <span t-if="record.coin_metal.raw_value" class="badge rounded-pill text-bg-warning me-1">
                                        <field name="coin_metal"/>
                                    </span>
                                    <span t-if="record.coin_finish.raw_value" class="badge rounded-pill text-bg-info me-1">
                                        <field name="coin_finish"/>
                                    </span>
                                    <span t-if="record.coin_cover_values.raw_value" class="badge rounded-pill text-bg-secondary">
                                        <field name="coin_cover_values"/>
                                    </span>
                                </div>
                                <div t-if="record.customer_id.raw_value" class="mt-1 text-muted small">
                                    <i class="fa fa-user me-1"/><field name="customer_id"/>
                                    <span t-if="record.customer_phone.raw_value"> · <field name="customer_phone"/></span>
                                    <span t-if="record.customer_email.raw_value"> · <field name="customer_email"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         SEARCH VIEW
         ================================================================ -->
    <record id="view_coin_product_template_search" model="ir.ui.view">
        <field name="name">coin.product.template.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Search Coins &amp; Medals">
                <field name="name" string="Coin"/>
                <field name="default_code" string="SKU / Ref"/>
                <field name="issuing_country_id" string="Issuing Authority"/>
                <separator/>
                <filter string="In-House Products" name="filter_eigenprodukte"
                        domain="[('categ_id.name', 'ilike', '002 Münzen Eigenprodukte')]"/>
                <filter string="Client Products" name="filter_kundenprodukte"
                        domain="[('categ_id.name', 'ilike', '003 Münzen Kundenprodukte')]"/>
                <filter string="Medals" name="filter_medaillen"
                        domain="[('categ_id.name', 'ilike', '004 Medaillen')]"/>
                <separator/>
                <filter string="Gold Coins" name="filter_gold" domain="[('coin_metal', '=', 'gold')]"/>
                <filter string="Silver Coins" name="filter_silver" domain="[('coin_metal', '=', 'silver')]"/>
                <separator/>
                <filter string="In Stock" name="filter_in_stock" domain="[('qty_available', '&gt;', 0)]"/>
                <filter string="Starred / Favorites" name="filter_favorites" domain="[('is_favorite', '=', True)]"/>
                <separator/>
                <filter string="Category" name="groupby_category" context="{'group_by': 'categ_id'}"/>
                <filter string="Precious Metal" name="groupby_metal" context="{'group_by': 'coin_metal'}"/>
                <filter string="Finish" name="groupby_finish" context="{'group_by': 'coin_finish'}"/>
                <filter string="Year of Issue" name="groupby_year" context="{'group_by': 'year_of_issue'}"/>
                <filter string="Issuing Authority" name="groupby_country" context="{'group_by': 'issuing_country_id'}"/>
            </search>
        </field>
    </record>

    <!-- ================================================================
         FORM VIEW EXTENSION
         ================================================================ -->
    <record id="view_coin_product_template_form_inherit" model="ir.ui.view">
        <field name="name">coin.product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Obverse / reverse thumbnails displayed next to the smart button box -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="after">
                <div class="oe_avatar d-flex" invisible="not is_coin_product">
                    <field name="obverse_image" widget="image" class="oe_avatar"
                           options="{'size': [90, 90]}" alt="Obverse"/>
                    <field name="reverse_image" widget="image" class="oe_avatar"
                           options="{'size': [90, 90]}" alt="Reverse"/>
                </div>
            </xpath>

            <!-- Numismatics / Coin Details notebook tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Numismatics / Coin Details" name="page_coin_details">
                    <field name="is_coin_product"/>
                    <group>
                        <group string="Technical Specifications">
                            <field name="coin_metal"/>
                            <field name="coin_finish"/>
                            <field name="coin_weight"/>
                            <field name="coin_diameter"/>
                            <field name="coin_mintage"/>
                            <field name="year_of_issue"/>
                            <field name="issuing_country_id"/>
                        </group>
                        <group string="Obverse &amp; Reverse">
                            <field name="obverse_image" widget="image" nolabel="1"/>
                            <field name="reverse_image" widget="image" nolabel="1"/>
                        </group>
                    </group>
                    <group string="Webshop / WordPress Integration">
                        <field name="wp_pic_obverse_small"/>
                        <field name="wp_pic_reverse_small"/>
                    </group>
                </page>
            </xpath>

            <!-- Modern Odoo 19 chatter component is already provided by the base
                 product.template form view; no duplicate chatter is added here. -->

        </field>
    </record>

</odoo>
